name "graphqld2"
description "GraphQL server with bulk data resolution"
authors "Vladimir"
license "MIT"

targetPath "build"

sourcePaths "source"

dependency "graphqld:parser" repository="git+https://github.com/vpanteleev-sym/graphqld.git" version="542374109b26018c9542631c90d1ba2acef32a8b"
dependency "ae" repository="git+https://github.com/CyberShadow/ae.git" version="573324089882f307cd619d67f02bb4e11c1eb69c"

configuration "library" {
    targetType "library"
}

configuration "postgres-integration" {
    targetType "executable"
    mainSourceFile "integration/postgres_test.d"
    importPaths "integration"
}
