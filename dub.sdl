name "dunamis"
description "GraphQL server for D that eliminates N+1 queries through expression-based query optimization"
authors "Vladimir"
license "MIT"

targetPath "build"

buildType "ci" {
    buildOptions "debugMode" "debugInfo"
    buildRequirements "disallowDeprecations"
}

sourcePaths "source"

dependency "graphqld:parser" repository="git+https://github.com/CyberShadow/graphqld.git" version="7b8c9cd0f2482deab6a9ecb3dbf6d9d246860972"
dependency "ae" version="0.0.3893"

# Exclude sqlite modules from main package (available via subpackage, requires ae:sqlite)
excludedSourceFiles "source/dunamis/sqlite/*"

# Exclude integration tests from library build
excludedSourceFiles "source/integration/*"

configuration "library" {
    targetType "library"
}

configuration "postgres-integration" {
    targetType "executable"
    mainSourceFile "source/integration/postgres_test.d"
    sourceFiles "source/integration/test_framework.d" "source/integration/tests.d" "source/integration/schema.d" "source/integration/test_runner.d"
    debugVersions "ASOCKETS_DEBUG_IDLE"
}

configuration "sqlite-integration" {
    targetType "executable"
    mainSourceFile "source/integration/sqlite_test.d"
    sourceFiles "source/integration/test_framework.d" "source/integration/tests.d" "source/integration/schema.d" "source/integration/test_runner.d"
    # Include sqlite sources directly for integration test
    sourceFiles "source/dunamis/sqlite/ddl.d" "source/dunamis/sqlite/dialect.d" "source/dunamis/sqlite/fetcher.d" "source/dunamis/sqlite/sql.d" "source/dunamis/sqlite/package.d"
    dependency "ae:sqlite" version="0.0.3893"
    debugVersions "ASOCKETS_DEBUG_IDLE"
}

configuration "mysql-integration" {
    targetType "executable"
    mainSourceFile "source/integration/mysql_test.d"
    sourceFiles "source/integration/test_framework.d" "source/integration/tests.d" "source/integration/schema.d" "source/integration/test_runner.d"
    debugVersions "ASOCKETS_DEBUG_IDLE"
}

# SQLite subpackage - for users who want sqlite support
subPackage {
    name "sqlite"
    targetType "library"

    # Include both sqlite sources and main package sources
    sourcePaths "source"

    # Exclude integration tests
    excludedSourceFiles "source/integration/*"

    dependency "graphqld:parser" repository="git+https://github.com/CyberShadow/graphqld.git" version="7b8c9cd0f2482deab6a9ecb3dbf6d9d246860972"
    dependency "ae:sqlite" version="0.0.3893"
}
