/// Optional plugin that auto-generates subscription fields for entities.
///
/// Discovers entities via `@TableEntity` UDAs on the Query type (from `Table` mixin)
/// and generates `<entity>Created`, `<entity>Updated`, `<entity>Deleted` fields
/// on the Subscription type. Each field returns an `EventSourceExpr` that delivers
/// a single entity instance when the corresponding change event fires.
///
/// Example:
/// ---
/// alias BaseSchema = Schema!(Query);
/// alias MySchema = ApplyPlugins!(BaseSchema, RdbmsSubscriptionPlugin, FilterPlugin, SortingPlugin);
/// ---
module dunamis.schema.subscriptions;

import dunamis.schema.plugin : isSchema;

// ============================================================================
// RdbmsSubscriptionPlugin
// ============================================================================

/// Plugin that auto-generates subscription fields for all entities with `Table`
/// entries in the Query type. Entities are detected via `@TableEntity` UDAs
/// (generated by the `Table` mixin).
///
/// For each entity, generates:
/// - `<entity>Created` — fires when a new entity is inserted
/// - `<entity>Updated` — fires when an entity is modified
/// - `<entity>Deleted` — fires when an entity is removed
///
/// Each field returns an `EventSourceExpr!Entity` that resolves when the
/// corresponding change event fires. The subscriber evaluates the selection
/// set against the event payload.
template RdbmsSubscriptionPlugin(alias S) if (isSchema!S) {
    import dunamis.schema.plugin : WrapFields, IdentityTypeMap, ForwardField;

    alias Query = S.Query;
    alias Mutation = S.Mutation;

    struct GeneratedSubscription {
        // Forward existing subscription fields
        mixin WrapFields!(S.Subscription, IdentityTypeMap, ForwardField);

        // Generate subscription fields for each entity discovered from Query
        static foreach (_member; __traits(allMembers, S.Query)) {
            static if (_isEntityField!(S.Query, _member)) {
                mixin _SubscriptionFieldsMixin!(
                    _extractNormalizedEntity!(S.Query, _member),
                    S
                );
            }
        }
    }

    alias Subscription = GeneratedSubscription;
}

/// Mixin template that generates subscription fields for a single entity type.
/// Gets the entity name from `@OriginalName` UDA (set by normalization chain).
mixin template _SubscriptionFieldsMixin(Entity, alias S) {
    static import dunamis.core.expr;
    static import dunamis.core.expr.combinators;
    mixin(() {
        import dunamis.schema.plugin : OriginalName;

        // Get entity name from @OriginalName UDA
        enum typeName = () {
            static foreach (attr; __traits(getAttributes, Entity)) {
                static if (is(typeof(attr) == OriginalName))
                    return attr.name;
            }
            return __traits(identifier, Entity);
        }();

        // Lowercase first letter for field name
        enum fieldBase = () {
            char[] name = typeName.dup;
            if (name.length > 0 && name[0] >= 'A' && name[0] <= 'Z')
                name[0] = cast(char)(name[0] + ('a' - 'A'));
            return cast(string) name;
        }();

        string result = "";

        // <entity>Created
        static if (!__traits(hasMember, S.Subscription, fieldBase ~ "Created")) {
            result ~= "static dunamis.core.expr.Expr!(Entity) " ~
                fieldBase ~ "Created" ~
                "(dunamis.core.expr.Expr!(typeof(this)) parent) {" ~
                " return dunamis.core.expr.combinators.eventSource!(Entity)(); }\n";
        }

        // <entity>Updated
        static if (!__traits(hasMember, S.Subscription, fieldBase ~ "Updated")) {
            result ~= "static dunamis.core.expr.Expr!(Entity) " ~
                fieldBase ~ "Updated" ~
                "(dunamis.core.expr.Expr!(typeof(this)) parent) {" ~
                " return dunamis.core.expr.combinators.eventSource!(Entity)(); }\n";
        }

        // <entity>Deleted
        static if (!__traits(hasMember, S.Subscription, fieldBase ~ "Deleted")) {
            result ~= "static dunamis.core.expr.Expr!(Entity) " ~
                fieldBase ~ "Deleted" ~
                "(dunamis.core.expr.Expr!(typeof(this)) parent) {" ~
                " return dunamis.core.expr.combinators.eventSource!(Entity)(); }\n";
        }

        return result;
    }());
}

/// Check if a Query member is an entity-backed field (has @TableEntity UDA).
private template _isEntityField(alias QueryType, string member) {
    import dunamis.relational.schema.attrs : hasTableEntity;
    enum _isEntityField = __traits(compiles, hasTableEntity!(__traits(getMember, QueryType, member))) &&
                          hasTableEntity!(__traits(getMember, QueryType, member));
}

/// Extract the normalized entity type from a Query field's return type.
private template _extractNormalizedEntity(alias QueryType, string member) {
    import std.traits : ReturnType, isSomeString;
    import dunamis.core.expr : ExprResultType;

    alias method = __traits(getMember, QueryType, member);
    alias ResultT = ExprResultType!(ReturnType!method);

    static if (is(ResultT == E[], E) && !isSomeString!ResultT) {
        alias _extractNormalizedEntity = E;
    } else {
        alias _extractNormalizedEntity = ResultT;
    }
}

// ============================================================================
// Unit Tests
// ============================================================================

// Test: SDL generation — subscription fields appear for entities
unittest {
    import std.algorithm : canFind;
    import dunamis.relational.schema : Col, Table;
    import dunamis.relational.demo : DemoEntity, DemoId, MockDB;
    import dunamis.graphql.schema : Schema, generateSchemaSDL;

    static MockDB!() db;

    @DemoEntity!(db, "users")
    static struct User {
        mixin DemoId;
        mixin Col!("name", string);
    }

    static struct Query {
        mixin Table!(User, "users");
    }

    alias BaseSchema = Schema!Query;
    alias MySchema = RdbmsSubscriptionPlugin!BaseSchema;

    static assert(isSchema!MySchema);

    enum sdl = generateSchemaSDL!MySchema;

    static assert(sdl.canFind("userCreated"), "Missing userCreated: " ~ sdl);
    static assert(sdl.canFind("userUpdated"), "Missing userUpdated: " ~ sdl);
    static assert(sdl.canFind("userDeleted"), "Missing userDeleted: " ~ sdl);
    static assert(sdl.canFind("type Subscription"), "Missing Subscription type: " ~ sdl);
}

// Test: existing subscription fields are preserved
unittest {
    import std.algorithm : canFind;
    import dunamis.core.expr : Expr;
    import dunamis.core.expr.combinators : eventSource;
    import dunamis.relational.schema : Col, Table;
    import dunamis.relational.demo : DemoEntity, DemoId, MockDB;
    import dunamis.graphql.schema : Schema, generateSchemaSDL;

    static MockDB!() db;

    @DemoEntity!(db, "users")
    static struct User {
        mixin DemoId;
        mixin Col!("name", string);
    }

    static struct Query {
        mixin Table!(User, "users");
    }

    // Custom subscription with a field that would conflict
    static struct Subscription {
        static Expr!User userCreated(Expr!Subscription s) {
            return eventSource!User();
        }
    }

    alias BaseSchema = Schema!(Query, void, Subscription);
    alias MySchema = RdbmsSubscriptionPlugin!BaseSchema;

    enum sdl = generateSchemaSDL!MySchema;

    // Should have the custom field and the auto-generated ones
    static assert(sdl.canFind("userCreated"), "Missing userCreated: " ~ sdl);
    static assert(sdl.canFind("userUpdated"), "Missing userUpdated: " ~ sdl);
    static assert(sdl.canFind("userDeleted"), "Missing userDeleted: " ~ sdl);
}

// Test: multiple entities generate fields for all
unittest {
    import std.algorithm : canFind;
    import dunamis.relational.schema : Col, Table;
    import dunamis.relational.demo : DemoEntity, DemoId, MockDB;
    import dunamis.graphql.schema : Schema, generateSchemaSDL;

    static MockDB!() db;

    @DemoEntity!(db, "users")
    static struct User {
        mixin DemoId;
        mixin Col!("name", string);
    }

    @DemoEntity!(db, "posts")
    static struct Post {
        mixin DemoId;
        mixin Col!("title", string);
    }

    static struct Query {
        mixin Table!(User, "users");
        mixin Table!(Post, "posts");
    }

    alias MySchema = RdbmsSubscriptionPlugin!(Schema!Query);

    enum sdl = generateSchemaSDL!MySchema;

    static assert(sdl.canFind("userCreated"), "Missing userCreated: " ~ sdl);
    static assert(sdl.canFind("userUpdated"), "Missing userUpdated: " ~ sdl);
    static assert(sdl.canFind("userDeleted"), "Missing userDeleted: " ~ sdl);
    static assert(sdl.canFind("postCreated"), "Missing postCreated: " ~ sdl);
    static assert(sdl.canFind("postUpdated"), "Missing postUpdated: " ~ sdl);
    static assert(sdl.canFind("postDeleted"), "Missing postDeleted: " ~ sdl);
}
