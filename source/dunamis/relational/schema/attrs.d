module dunamis.relational.schema.attrs;

import std.json : JSONValue;

import dunamis.core.expr : ExprResultType;

// ============================================================================
// DDL Metadata UDAs
// ============================================================================
// These UDAs are auto-generated by mixins and used by DDL generation.
// They provide SQL metadata (column names, FK relationships) while the
// method signatures provide GraphQL schema info.

/// SQL column name for DDL generation.
/// Auto-generated by Col mixin.
struct SqlColumn {
    string name;
}

/// UDA on a value type a database stores in a representation of its own
/// (e.g. a PostgreSQL range type, which row_to_json renders as its text
/// form): `decode` converts a column's non-null JSON value, as the database
/// returns it, to the type. Without it, struct values are decoded from JSON
/// objects with a member per field.
///
/// Example:
/// ---
/// @DecodedBy!decodeSpan
/// struct Span { int from; int to; }
/// Span decodeSpan(JSONValue v) { ... }
/// ---
struct DecodedBy(alias decode) {}

/// Whether values of type `T` are decoded by a function `T` declares with
/// `@DecodedBy`.
template hasDecodedBy(T) {
    import std.traits : hasUDA;
    static if (is(T == struct))
        enum bool hasDecodedBy = hasUDA!(T, DecodedBy);
    else
        enum bool hasDecodedBy = false;
}

/// Decode a column's non-null JSON value with the function `T` declares
/// with `@DecodedBy`.
T decodeWithDeclaredDecoder(T)(JSONValue value) if (hasDecodedBy!T) {
    import std.traits : getUDAs;
    static if (is(getUDAs!(T, DecodedBy)[0] == DecodedBy!decode, alias decode))
        return decode(value);
}

// ============================================================================
// Primary Key Support
// ============================================================================

/// Marks a field as part of the primary key.
/// Used on plain fields to identify entity instances.
enum PrimaryKey;

/// Marks a primary key field as auto-increment.
/// Used alongside @PrimaryKey to indicate the database generates the value.
/// Affects DDL generation (SERIAL/AUTO_INCREMENT) and INSERT behavior
/// (use LAST_INSERT_ID/last_insert_rowid instead of explicit PK lookup).
enum AutoIncrement;

/// Check if a specific member has @PrimaryKey UDA.
template hasPrimaryKeyAttr(T, string member) {
    import std.meta : staticIndexOf;
    enum hasPrimaryKeyAttr = staticIndexOf!(PrimaryKey, __traits(getAttributes, __traits(getMember, T, member))) >= 0;
}

/// Check if a specific member has @AutoIncrement UDA.
template hasAutoIncrementAttr(T, string member) {
    import std.meta : staticIndexOf;
    enum hasAutoIncrementAttr = staticIndexOf!(AutoIncrement, __traits(getAttributes, __traits(getMember, T, member))) >= 0;
}

/// Check if any @PrimaryKey field in the type also has @AutoIncrement.
/// Uses T.tupleof to avoid forward reference cycles — see hasPrimaryKey for details.
template hasAutoIncrement(T) {
    import std.meta : staticIndexOf;
    enum hasAutoIncrement = () {
        static foreach (field; T.tupleof) {
            static if (staticIndexOf!(PrimaryKey, __traits(getAttributes, field)) >= 0 &&
                       staticIndexOf!(AutoIncrement, __traits(getAttributes, field)) >= 0) {
                return true;
            }
        }
        return false;
    }();
}

/// Check if any field in the type has @PrimaryKey.
///
/// Uses a two-phase approach to avoid DMD forward reference cycles:
///
/// Phase 1: T.tupleof (data fields only). This is safe during mixin expansion because
/// tupleof only enumerates plain data fields without triggering semantic analysis of
/// mixin-generated methods. The problem it avoids: when an entity has a computed field
/// with `static auto` return type (e.g. `static auto fullName(Expr!User u) => ...`),
/// DMD eagerly analyzes the method body for return type deduction. This triggers
/// Expr!User.opDispatch → Col method → column!() → ColumnAccessExpr class vtable →
/// eval() → entityToRef!User → getPrimaryKeyFieldNames!User → __traits(allMembers, User),
/// but User's mixins haven't finished expanding yet → forward reference error.
///
/// Phase 2: __traits(allMembers) fallback. Needed for normalized entity types where
/// NormalizeFields converts PK plain fields into static methods (preserving the
/// @PrimaryKey UDA). These types are always fully constructed, so
/// __traits(allMembers) is safe — the forward reference issue only affects types
/// that are mid-construction.
///
/// A proper compiler-level fix would involve deferring semantic analysis of static
/// method bodies (e.g. by wrapping them in zero-argument templates), but that requires
/// changes to how mixins generate field accessor methods.
template hasPrimaryKey(T) {
    import std.meta : staticIndexOf;
    enum hasPrimaryKey = () {
        // Phase 1: check tupleof (plain data fields) — safe during mixin expansion
        static foreach (field; T.tupleof) {
            static if (staticIndexOf!(PrimaryKey, __traits(getAttributes, field)) >= 0) {
                return true;
            }
        }
        // Phase 2: check allMembers — needed for normalized types where PK is a method
        static foreach (member; __traits(allMembers, T)) {
            static if (hasPrimaryKeyAttr!(T, member)) {
                return true;
            }
        }
        return false;
    }();
}

/// Get @PrimaryKey field names.
/// Uses T.tupleof to avoid forward reference cycles — see hasPrimaryKey for details.
template getPrimaryKeyFieldNames(T) {
    import std.meta : staticIndexOf;
    enum getPrimaryKeyFieldNames = () {
        string[] names;
        static foreach (field; T.tupleof) {
            static if (staticIndexOf!(PrimaryKey, __traits(getAttributes, field)) >= 0) {
                names ~= __traits(identifier, field);
            }
        }
        return names;
    }();
}

/// Check if a type is an entity (has @PrimaryKey field).
template isEntityType(T) {
    enum isEntityType = hasPrimaryKey!T;
}

// ============================================================================
// Entity UDA
// ============================================================================
// Applied to struct types to mark them as database entities.
// Carries compile-time metadata: data source alias and SQL table name.

/// UDA for entity structs. Binds an entity to its data source and table.
///
/// Example:
/// ---
/// @Entity!(db, "users")
/// struct User {
///     @PrimaryKey long id;
///     mixin Col!("firstName", string);
/// }
/// ---
struct Entity(alias _db, string _tableName, string _typeName = "") {
    alias db = _db;
    enum table = _tableName;
    enum typeName = _typeName;
}

/// Check if a type has entity metadata (@Entity or @DemoEntity UDA)
template hasEntityAttr(T) {
    enum hasEntityAttr = () {
        static foreach (attr; __traits(getAttributes, T)) {
            static if (__traits(compiles, attr.db) && __traits(compiles, attr.table)) {
                return true;
            }
        }
        return false;
    }();
}

/// Extract the data source alias from @Entity or @DemoEntity UDA
template getEntityDb(T) {
    alias attrs = __traits(getAttributes, T);
    template Impl(A...) {
        static foreach (attr; A) {
            static if (__traits(compiles, attr.db) && __traits(compiles, attr.table)) {
                alias Impl = attr.db;
            }
        }
    }
    alias getEntityDb = Impl!attrs;
}

/// Extract the SQL table name from @Entity or @DemoEntity UDA
template getEntityTable(T) {
    static assert(hasEntityAttr!T, "No @Entity or @DemoEntity UDA found on " ~ T.stringof);
    enum getEntityTable = () {
        static foreach (attr; __traits(getAttributes, T)) {
            static if (__traits(compiles, attr.db) && __traits(compiles, attr.table)) {
                return attr.table;
            }
        }
    }();
}

/// Extract the GraphQL type name from @Entity or @DemoEntity UDA, or struct name
template getEntityTypeName(T) {
    enum getEntityTypeName = () {
        static foreach (attr; __traits(getAttributes, T)) {
            static if (__traits(compiles, attr.db) && __traits(compiles, attr.table)) {
                static if (attr.typeName.length > 0)
                    return attr.typeName;
                else
                    return __traits(identifier, T);
            }
        }
        return __traits(identifier, T);
    }();
}

/// References another entity (for FK columns).
/// Auto-generated by Col mixin for ForeignKey!Entity column types.
/// The Parent template parameter is the referenced entity type.
struct ForeignKeyRef(Parent) {
    alias referencedEntity = Parent;
}

/// Extract the referenced entity from a @ForeignKeyRef UDA.
template extractForeignKeyRef(alias method) {
    alias attrs = __traits(getAttributes, method);
    enum found = () {
        static foreach (attr; attrs) {
            static if (__traits(compiles, attr.referencedEntity)) {
                return true;
            }
        }
        return false;
    }();
    static assert(found, "No @ForeignKeyRef UDA found on method");

    alias extractForeignKeyRef = extractForeignKeyRefImpl!attrs;
}

private template extractForeignKeyRefImpl(attrs...) {
    static foreach (attr; attrs) {
        static if (__traits(compiles, attr.referencedEntity)) {
            alias extractForeignKeyRefImpl = attr.referencedEntity;
        }
    }
}

/// Check if a method has a @ForeignKeyRef UDA
template hasForeignKeyRef(alias method) {
    alias attrs = __traits(getAttributes, method);
    enum hasForeignKeyRef = () {
        static foreach (attr; attrs) {
            static if (__traits(compiles, attr.referencedEntity)) {
                return true;
            }
        }
        return false;
    }();
}

/// FK column name in child table (for HasMany relationships).
/// Auto-generated by HasMany mixin.
struct HasManyFK {
    string foreignKey;
}

/// Child entity type for HasMany relationships.
/// Auto-generated by HasMany mixin.
struct HasManyChild(Child) {
