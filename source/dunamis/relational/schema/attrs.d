/// Get column names for @PrimaryKey fields.
/// Maps each PK D field name to its column name via @SqlColumn UDA or snake_case.
template getPkColumns(Entity) {
    enum getPkColumns = () {
        string[] result;
        static foreach (fieldName; getPrimaryKeyFieldNames!Entity) {
            result ~= getPlainFieldColumnName!(Entity, fieldName);
        }
        if (result.length == 0) result = ["id"];  // fallback
        return result;
    }();
}

/// Check if a method returns a nullable type (Expr!(Nullable!T))
template hasNullableReturn(alias method) {
    import std.traits : ReturnType;
    import std.typecons : Nullable;
    alias Return = ReturnType!method;
    alias ResultT = ExprResultType!Return;
    enum hasNullableReturn = is(ResultT == Nullable!U, U);
}

/// The value type of a belongs-to relationship through the foreign key `fk`
/// (a column method or a plain field carrying `@ForeignKeyRef!Parent`):
/// `Nullable!Parent` if the foreign key is nullable, else `Parent`.
template BelongsToTarget(alias fk) {
    import std.typecons : Nullable;
    alias Parent = extractForeignKeyRef!fk;
    static if (is(typeof(fk) == function))
        enum nullable = hasNullableReturn!fk;
    else
        enum nullable = is(typeof(fk) == Nullable!U, U);
    static if (nullable)
        alias BelongsToTarget = Nullable!Parent;
    else
        alias BelongsToTarget = Parent;
}

/// Marks a root field (Table mixin) with its entity type.
/// Auto-generated by Table mixin.
struct TableEntity(Entity) {
    alias entityType = Entity;
}

/// Extract entity type from @TableEntity UDA
template extractTableEntity(alias method) {
    alias attrs = __traits(getAttributes, method);
    enum found = () {
        static foreach (attr; attrs) {
            static if (__traits(compiles, attr.entityType)) {
                return true;
            }
        }
        return false;
    }();
    static assert(found, "No @TableEntity UDA found on method");

    alias extractTableEntity = extractTableEntityImpl!attrs;
}

private template extractTableEntityImpl(attrs...) {
    static foreach (attr; attrs) {
        static if (__traits(compiles, attr.entityType)) {
            alias extractTableEntityImpl = attr.entityType;
        }
    }
}

/// Check if a method has a @TableEntity UDA
template hasTableEntity(alias method) {
    alias attrs = __traits(getAttributes, method);
    enum hasTableEntity = () {
        static foreach (attr; attrs) {
            static if (__traits(compiles, attr.entityType)) {
                return true;
            }
        }
        return false;
    }();
}
