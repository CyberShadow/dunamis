/// Get the @HasManyFK value from a method
template getHasManyFK(alias method) {
    alias attrs = __traits(getAttributes, method);
    enum getHasManyFK = () {
        static foreach (attr; attrs) {
            static if (is(typeof(attr) == HasManyFK)) {
                return attr.foreignKey;
            }
        }
        return "";
    }();
}

/// Check if a method has @HasManyFK UDA
template hasHasManyFK(alias method) {
    enum hasHasManyFK = getHasManyFK!method.length > 0;
}

// ============================================================================
// Plain Field Support (from core)
// ============================================================================

// Import plain field detection from core
public import dunamis.core.types : isPlainField, getPlainFieldNames;

/// Get the column name for a plain field.
/// Uses @SqlColumn.name if present, otherwise converts field name to snake_case.
template getPlainFieldColumnName(Entity, string fieldName) {
    import dunamis.relational.schema.mixins : toSnakeCase;

    enum getPlainFieldColumnName = () {
        // Check for @SqlColumn with explicit column name
        static if (__traits(compiles, __traits(getAttributes, __traits(getMember, Entity, fieldName)))) {
            alias attrs = __traits(getAttributes, __traits(getMember, Entity, fieldName));
            static foreach (attr; attrs) {
                static if (is(typeof(attr) == SqlColumn)) {
                    return attr.name;
                }
            }
        }
        // Default: convert field name to snake_case
        return toSnakeCase(fieldName);
    }();
}

/// FK field name in this entity (for BelongsTo relationships).
/// Auto-generated by BelongsTo mixin.
struct BelongsToFK {
    string fkField;
}

