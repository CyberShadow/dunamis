// ============================================================================
// DDL Metadata UDAs
// ============================================================================
// These UDAs are auto-generated by mixins and used by DDL generation.
// They provide SQL metadata (column names, FK relationships) while the
// method signatures provide GraphQL schema info.

/// SQL column name for DDL generation.
/// Auto-generated by Col mixin.
struct SqlColumn {
    string name;
}

/// Marks a column as part of the primary key for DDL generation.
/// Auto-generated by Col mixin when used with PrimaryKey mixin.
enum PrimaryKeyAttr;

/// References another entity (for FK columns).
/// Auto-generated by Col mixin for ForeignKey!Entity column types.
/// The Parent template parameter is the referenced entity type.
struct ForeignKeyRef(Parent) {
    alias referencedEntity = Parent;
}

/// Extract the referenced entity from a @ForeignKeyRef UDA.
template extractForeignKeyRef(alias method) {
    alias attrs = __traits(getAttributes, method);
    enum found = () {
        static foreach (attr; attrs) {
            static if (__traits(compiles, attr.referencedEntity)) {
                return true;
            }
        }
        return false;
    }();
    static assert(found, "No @ForeignKeyRef UDA found on method");

    alias extractForeignKeyRef = extractForeignKeyRefImpl!attrs;
}

private template extractForeignKeyRefImpl(attrs...) {
    static foreach (attr; attrs) {
        static if (__traits(compiles, attr.referencedEntity)) {
            alias extractForeignKeyRefImpl = attr.referencedEntity;
        }
    }
}

/// Check if a method has a @ForeignKeyRef UDA
template hasForeignKeyRef(alias method) {
    alias attrs = __traits(getAttributes, method);
    enum hasForeignKeyRef = () {
        static foreach (attr; attrs) {
            static if (__traits(compiles, attr.referencedEntity)) {
                return true;
            }
        }
        return false;
    }();
}

