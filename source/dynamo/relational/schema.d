// Import plain field detection from core
public import dynamo.core.types : isPlainField, getPlainFieldNames;

/// Get the column name for a plain field.
/// Uses @SqlColumn.name if present, otherwise converts field name to snake_case.
template getPlainFieldColumnName(Entity, string fieldName) {
    enum getPlainFieldColumnName = () {
        // Check for @SqlColumn with explicit column name
        static if (__traits(compiles, __traits(getAttributes, __traits(getMember, Entity, fieldName)))) {
            alias attrs = __traits(getAttributes, __traits(getMember, Entity, fieldName));
            static foreach (attr; attrs) {
                static if (is(typeof(attr) == SqlColumn)) {
                    return attr.name;
                }
            }
        }
        // Default: convert field name to snake_case
        return toSnakeCase(fieldName);
    }();
}

