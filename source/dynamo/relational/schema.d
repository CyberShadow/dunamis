/// Check if a method returns a nullable type (Expr!(Nullable!T))
template hasNullableReturn(alias method) {
    import std.traits : ReturnType;
    import std.typecons : Nullable;
    import dynamo.core.expr : ExprResultType;
    alias Return = ReturnType!method;
    alias ResultT = ExprResultType!Return;
    enum hasNullableReturn = is(ResultT == Nullable!U, U);
}

