/// Check if a method has @HasManyChild UDA
template hasHasManyChild(alias method) {
    alias attrs = __traits(getAttributes, method);
    enum hasHasManyChild = () {
        static foreach (attr; attrs) {
            static if (__traits(compiles, attr.childType)) {
                return true;
            }
        }
        return false;
    }();
}

/// Get the @HasManyFK value from a method
template getHasManyFK(alias method) {
    alias attrs = __traits(getAttributes, method);
    enum getHasManyFK = () {
        static foreach (attr; attrs) {
            static if (is(typeof(attr) == HasManyFK)) {
                return attr.foreignKey;
            }
        }
        return "";
    }();
}

/// Check if a method has @HasManyFK UDA
template hasHasManyFK(alias method) {
    enum hasHasManyFK = getHasManyFK!method.length > 0;
}

