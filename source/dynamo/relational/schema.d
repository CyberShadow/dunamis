// ============================================================================
// Query Root Mixin
// ============================================================================

/// Mixin to define a root query field that returns all entities of a type.
/// Used in a Query struct to define the schema's entry points.
///
/// The data source is derived from the Entity's _db alias, which is set
/// via the Entity mixin. This ensures consistency between the entity
/// definition and query access.
///
/// Example:
/// ---
/// // Module-level data source
/// static MyDB myDB;
///
/// struct User {
///     mixin Entity!(myDB, "users");  // Entity owns the data source
///     mixin Col!("email", string);
/// }
///
/// struct Query {
///     mixin Table!(User, "users");   // Derives db from User._db
///     mixin Table!(Post, "posts");
/// }
///
/// void main() {
///     myDB = new MyDB(connectionString);
///     auto query = map!(u => User.email(u))(Query.users());
/// }
/// ---
mixin template Table(Entity, string fieldName) {
    import dynamo.core.expr : Expr;
    import dynamo.relational.schema : TableEntity, getAll;

    // Method with UDA - follows unified root field signature
    @TableEntity!Entity
    mixin("static auto " ~ fieldName ~ "(Expr!(typeof(this)) parent) {
        return getAll!Entity();
    }");
}

/// Convenience mixin to define multiple table fields at once.
/// Field names are derived from entity type names (lowercased + pluralized).
/// Data source is derived from each entity's _db alias.
///
/// Example:
/// ---
/// static MyDB myDB;
///
/// struct User { mixin Entity!(myDB, "users"); }
/// struct Post { mixin Entity!(myDB, "posts"); }
///
/// struct Query {
///     mixin Tables!(User, Post, Comment);
///     // Equivalent to:
///     // mixin Table!(User, "users");
///     // mixin Table!(Post, "posts");
///     // mixin Table!(Comment, "comments");
/// }
/// ---
mixin template Tables(Entities...) {
    static foreach (Entity; Entities) {
        mixin Table!(Entity, defaultFieldName!Entity);
    }
}

/// Derive default field name from entity type (lowercase + "s" suffix)
private template defaultFieldName(Entity) {
    enum defaultFieldName = () {
        string name = EntityID!Entity.typeName;
        // Lowercase first character
        if (name.length > 0 && name[0] >= 'A' && name[0] <= 'Z') {
            return cast(char)(name[0] + 32) ~ name[1..$] ~ "s";
        }
        return name ~ "s";
    }();
}
// ============================================================================
// Entity Reference Type
// ============================================================================

/// Runtime entity reference with compile-time metadata.
/// The struct carries both the ID string and type-level metadata (db, table, typeName).
struct EntityRef(alias _db, string _tableName, string _typeName) {
    import std.string : indexOf;

    /// Data source (compile-time alias)
    alias db = _db;

    /// SQL table name (compile-time)
    enum table = _tableName;

    /// GraphQL type name (compile-time)
    enum typeName = _typeName;

    /// Runtime ID string (format: "TypeName:localId")
    string id;

    /// Construct from ID string
    this(string id) { this.id = id; }

    /// Extract the local ID portion (after the colon)
    string localId() const {
        auto sep = id.indexOf(':');
        return sep >= 0 ? id[sep + 1 .. $] : "";
    }

    /// For debugging
    string toString() const { return id; }
}

/// Extract entity metadata type from any entity struct.
/// Usage: EntityID!User.table, EntityID!User.typeName, EntityID!User.db
alias EntityID(Entity) = typeof(Entity.init.nodeId);

/// Check if an entity reference is valid (has non-empty ID).
/// Works via UFCS: entity.isValid()
bool isValid(E)(E entity) if (is(typeof(E.init.nodeId))) {
    return entity.nodeId.id.length > 0;
}

// ============================================================================
// Entity Mixin
// ============================================================================

/// The entity struct becomes a reference type - it holds a nodeId that identifies
/// a specific row in the database. Schema metadata is static, nodeId is runtime.
///
/// The data source is bound by alias, so it must be a static/module-level variable.
/// This allows both Table queries and mutations to access the same data source.
///
/// Example:
/// ---
/// static MyDB db;
///
/// struct User {
///     mixin Entity!(db, "users");
///     @PrimaryKeyAttr mixin Col!("id", long);
///     mixin Col!("email", string);
/// }
///
/// // Composite primary key
/// struct OrderItem {
///     mixin Entity!(db, "order_items");
///     @PrimaryKeyAttr mixin Col!("orderId", long);
///     @PrimaryKeyAttr mixin Col!("productId", long);
/// }
/// ---
mixin template Entity(alias db, string tableName, string typeName = "") {
    import dynamo.relational.schema : EntityRef;

    /// Entity reference with compile-time metadata and runtime ID
    static if (typeName.length > 0)
        EntityRef!(db, tableName, typeName) nodeId;
    else
        EntityRef!(db, tableName, __traits(identifier, typeof(this))) nodeId;

    /// Construct from ID string
    this(string id) { nodeId = typeof(nodeId)(id); }

    /// For debugging
    string toString() const { return nodeId.toString(); }
}

// ============================================================================
// Foreign Key Type
// ============================================================================

/// Foreign key reference to another entity.
/// Use with Col to define FK columns that reference another entity's primary key.
///
/// Examples:
///   mixin Col!("authorId", ForeignKey!User);              // references users.id
///   mixin Col!("email", ForeignKey!(User, "email"));      // references users.email
///
/// Benefits:
/// - Type is derived from the referenced column's type
/// - DDL generation automatically creates FOREIGN KEY constraints
/// - Single source of truth for the relationship
struct ForeignKey(Entity, string idField = "id") {
    import dynamo.core.expr : Expr, ExprResultType, isExpr;

    /// The referenced entity type
    alias referencedEntity = Entity;

    /// The referenced column name
    enum referencedColumn = idField;

    /// The underlying storage type (derived from referenced column method's return type)
    /// The column method returns Expr!T, so we extract T.
    /// For template methods, we need to instantiate first to get the return type.
    private alias _FieldMethod = __traits(getMember, Entity, idField);
    private alias _ReturnType = getMethodReturnType!(_FieldMethod, Expr!Entity);
    static assert(isExpr!_ReturnType,
        "Field '" ~ idField ~ "' in " ~ Entity.stringof ~ " must return an Expr type");
    alias StorageType = ExprResultType!_ReturnType;
}

/// Helper to get return type of a method, handling both regular and template functions.
/// For template functions, instantiates with the given argument type.
private template getMethodReturnType(alias method, ArgType) {
    static if (__traits(compiles, ReturnType!method)) {
        // Regular function - use ReturnType directly
        alias getMethodReturnType = ReturnType!method;
    } else static if (__traits(compiles, ReturnType!(method!()))) {
        // Template function with no args - instantiate
        alias getMethodReturnType = ReturnType!(method!());
    } else {
        // Try calling with the argument type
        alias getMethodReturnType = typeof(method(ArgType.init));
    }
}

/// Check if a type is a ForeignKey
template isForeignKey(T) {
    static if (is(T == ForeignKey!(E, col), E, string col)) {
        enum isForeignKey = true;
    } else {
        enum isForeignKey = false;
    }
}

/// Check if a type is a Nullable ForeignKey
template isNullableForeignKey(T) {
    static if (is(T == Nullable!(ForeignKey!(E, col)), E, string col)) {
        enum isNullableForeignKey = true;
    } else {
        enum isNullableForeignKey = false;
    }
}

/// Check if a type is any kind of ForeignKey (required or nullable)
template isAnyForeignKey(T) {
    enum isAnyForeignKey = isForeignKey!T || isNullableForeignKey!T;
}

/// Get the referenced entity from a ForeignKey type
template getForeignKeyEntity(T) {
    static if (is(T == ForeignKey!(E, col), E, string col)) {
        alias getForeignKeyEntity = E;
    } else static if (is(T == Nullable!(ForeignKey!(E, col)), E, string col)) {
        alias getForeignKeyEntity = E;
    } else {
        static assert(false, "Not a ForeignKey type");
    }
}

/// Get the inner ForeignKey type from a Nullable!(ForeignKey!(...))
template getInnerForeignKey(T) {
    static if (is(T == Nullable!(ForeignKey!(E, col)), E, string col)) {
        alias getInnerForeignKey = ForeignKey!(E, col);
    } else {
        static assert(false, "Not a Nullable ForeignKey type");
    }
}

/// Get the storage type for a column type.
/// For ForeignKey types, returns the referenced column's type.
/// For Nullable FKs, preserves the Nullable wrapper.
/// For regular types, returns T itself.
template getColumnStorageType(T) {
    import std.typecons : Nullable;
    static if (isNullableForeignKey!T) {
        alias getColumnStorageType = Nullable!(getInnerForeignKey!T.StorageType);
    } else static if (isForeignKey!T) {
        alias getColumnStorageType = T.StorageType;
    } else {
        alias getColumnStorageType = T;
    }
}

// ============================================================================
// Field Definition Mixins
// ============================================================================

/// Convert camelCase to snake_case at compile time
private string toSnakeCase(string input) {
    if (input.length == 0) return "";

    string result;
    foreach (i, c; input) {
        if (c >= 'A' && c <= 'Z') {
            if (i > 0) result ~= '_';
            result ~= cast(char)(c + 32);  // toLowerCase
        } else {
            result ~= c;
        }
    }
    return result;
}

/// Mixin to define a column accessor.
///
/// Examples:
///   mixin Col!("firstName", string);                      // regular column
///   mixin Col!("authorId", ForeignKey!User);              // required FK
///   mixin Col!("editorId", Nullable!(ForeignKey!User));   // nullable FK
///   mixin Col!("createdAt", string, "created_at");        // explicit column name
mixin template Col(string fieldName, T, string columnName = toSnakeCase(fieldName)) {
    import dynamo.relational.schema : isForeignKey, isNullableForeignKey, getForeignKeyEntity;
    import dynamo.relational.schema : getColumnStorageType, column;
    import dynamo.relational.schema : SqlColumn, ForeignKeyRef;
    import dynamo.core.expr : Expr;

    static if (isNullableForeignKey!T) {
        // Nullable FK column - nullability preserved in return type via getColumnStorageType
        @SqlColumn(columnName) @ForeignKeyRef!(getForeignKeyEntity!T)
        mixin("static auto " ~ fieldName ~ "(Expr!(typeof(this)) e) {
            return e.column!(getColumnStorageType!T, typeof(this))(\"" ~ columnName ~ "\");
        }");
    } else static if (isForeignKey!T) {
        // Required FK column
        @SqlColumn(columnName) @ForeignKeyRef!(getForeignKeyEntity!T)
        mixin("static auto " ~ fieldName ~ "(Expr!(typeof(this)) e) {
            return e.column!(getColumnStorageType!T, typeof(this))(\"" ~ columnName ~ "\");
        }");
    } else {
        // Regular column - nullability in T (e.g., Nullable!string) preserved in return type
        @SqlColumn(columnName)
        mixin("static auto " ~ fieldName ~ "(Expr!(typeof(this)) e) {
            return e.column!(T, typeof(this))(\"" ~ columnName ~ "\");
        }");
    }
}

/// Mixin to define a hasMany relationship.
/// Example: mixin HasMany!("posts", Post, "author_id");
mixin template HasMany(string fieldName, Child, string fk) {
    import dynamo.core.expr : Expr;
    import dynamo.relational.schema : HasManyFK, hasMany, HasManyChild;

    // Method with UDAs - takes Expr!Parent, returns Expr!(Child[])
    @HasManyFK(fk) @HasManyChild!Child
    mixin("static auto " ~ fieldName ~ "(Expr!(typeof(this)) e) {
        return hasMany!(Child, fk, typeof(this))(e);
    }");
}

/// Mixin to define a belongsTo relationship by referencing a FK column.
/// The parent entity type and nullability are derived from the FK column definition.
///
/// Examples:
///   mixin Col!("authorId", ForeignKey!User);              // required FK column
///   mixin BelongsTo!("author", "authorId");               // derives User, nullable=false
///
///   mixin Col!("editorId", Nullable!(ForeignKey!User));   // nullable FK column
///   mixin BelongsTo!("editor", "editorId");               // derives User, nullable=true
mixin template BelongsTo(string fieldName, string fkFieldName) {
    import dynamo.core.expr : Expr;
    import std.typecons : Nullable;
    import dynamo.relational.schema : belongsTo, BelongsToFK, BelongsToParent;
    import dynamo.relational.schema : extractForeignKeyRef, hasForeignKeyRef, getSqlColumn, hasNullableReturn;

    // Verify it's a foreign key column (has @ForeignKeyRef UDA)
    static assert(hasForeignKeyRef!(__traits(getMember, typeof(this), fkFieldName)),
        "Field '" ~ fkFieldName ~ "' must be a ForeignKey column for BelongsTo");

    // Check if FK column returns nullable type (determines relationship nullability)
    static if (hasNullableReturn!(__traits(getMember, typeof(this), fkFieldName))) {
        @BelongsToFK(fkFieldName)
        @BelongsToParent!(extractForeignKeyRef!(__traits(getMember, typeof(this), fkFieldName)))
        mixin("static auto " ~ fieldName ~ "(Expr!(typeof(this)) e) {
            alias Fk = __traits(getMember, typeof(this), \"" ~ fkFieldName ~ "\");
            return e.belongsTo!(extractForeignKeyRef!Fk, Nullable!(extractForeignKeyRef!Fk), getSqlColumn!Fk, typeof(this))();
        }");
    } else {
        @BelongsToFK(fkFieldName)
        @BelongsToParent!(extractForeignKeyRef!(__traits(getMember, typeof(this), fkFieldName)))
        mixin("static auto " ~ fieldName ~ "(Expr!(typeof(this)) e) {
            alias Fk = __traits(getMember, typeof(this), \"" ~ fkFieldName ~ "\");
            return e.belongsTo!(extractForeignKeyRef!Fk, extractForeignKeyRef!Fk, getSqlColumn!Fk, typeof(this))();
        }");
    }
}

// ============================================================================
// UFCS Access Functions
// ============================================================================

/// Column access - reads a column value for each entity ref.
/// Takes typed Expr!Entity for compile-time type safety.
auto column(T, Entity)(Expr!Entity input, string name) {
    return new ColumnAccessExpr!(T, Entity)(input, name);
}

/// HasMany relationship - returns collection of child entities for each parent.
/// Takes typed Expr!Parent and returns Expr!(Child[]).
auto hasMany(Child, string fk, Parent)(Expr!Parent input) {
    return new HasManyAccessExpr!(Parent, Child, fk)(input);
}

/// BelongsTo relationship - returns parent entity for each child.
/// Takes typed Expr!Child and returns Expr!Parent or Expr!(Nullable!Parent).
/// ResultType should be Parent (required FK) or Nullable!Parent (optional FK).
auto belongsTo(Parent, ResultType = Parent, string fk, Child)(Expr!Child input) {
    return new BelongsToAccessExpr!(Child, Parent, ResultType, fk)(input);
}

// ============================================================================
// Helper: Find MapExpr from _input chain
// ============================================================================

/// Walk _input chain to find the owning MapExpr and collect join info.
/// Returns the MapExpr (as Object) or null if not found.
/// Also returns the base input expression (the one that produces refs for the
/// query node's base table) via the baseInput out parameter.
///
/// Accepts ExprBase to work with any Expr!Entity type.
Object findMapExprFromChain(ExprBase expr, ref JoinHop[] joinPath, out ExprBase baseInput) {
    import dynamo.core.expr : EveryItemOfExprInfo, UnwrapNullableInfo;

    // Track the first expression before any belongsTo chain starts
    // This produces refs for the query node's base table
    ExprBase lastBeforeBelongsTo = expr;
    bool inBelongsToChain = false;

    while (expr !is null) {
        // Check if we've reached EveryItemOfExpr (any instantiation)
        if (auto every = cast(EveryItemOfExprInfo) expr) {
            baseInput = inBelongsToChain ? lastBeforeBelongsTo : expr;
            return every.parentMap;
        }

        // Walk through access expressions using interfaces
        if (auto col = cast(ColumnAccessInfo) expr) {
            expr = col.inputExpr;
            continue;
        }
        if (auto belongs = cast(BelongsToInfo) expr) {
            // When entering a belongsTo chain, save the input that produces base entity refs
            if (!inBelongsToChain) {
                lastBeforeBelongsTo = belongs.inputExpr;
                inBelongsToChain = true;
            }
            // Collect join info for belongsTo hops
            joinPath = [JoinHop(
                belongs.childTable,
                belongs.parentTable,
                belongs.parentTypeName,
                belongs.fkColumn
            )] ~ joinPath;
            expr = belongs.inputExpr;
            continue;
        }
        if (auto hasMany = cast(HasManyInfo) expr) {
            expr = hasMany.inputExpr;
            continue;
        }
        // Unwrap nullable expressions - continue through to the nullable input
        if (auto unwrap = cast(UnwrapNullableInfo) expr) {
            expr = unwrap.inputExpr;
            continue;
        }
        // Unknown expression type
        break;
    }
    baseInput = null;
    return null;
}

/// A single hop in a belongsTo chain (for JOIN generation)
struct JoinHop {
    string sourceTable;   // e.g., "posts"
    string targetTable;   // e.g., "users"
    string targetType;    // e.g., "User"
    string fk;            // e.g., "author_id"
}

// ============================================================================
// Sorting Pattern Matching
// ============================================================================

/// Extract ORDER BY specs from a SortByInfo by pattern-matching its predicate.
///
/// Recognizes patterns like:
/// - (a, b) => a.column < b.column → ORDER BY column ASC
/// - (a, b) => a.column > b.column → ORDER BY column DESC
///
/// Returns empty array if pattern doesn't match.
private OrderBySpec[] extractSortBySpecs(SortByInfo sortByInfo) {
    import dynamo.core.expr : BinaryOpInfo;
    import dynamo.core.sorting : SortItemInfo, SortDirection, OrderBySpec;

    auto predicate = sortByInfo.sortPredicate;
    auto leftItem = sortByInfo.sortLeftItem;
    auto rightItem = sortByInfo.sortRightItem;

    // Try to match: BinaryOp(<, ColumnAccess(left, col), ColumnAccess(right, col))
    //           or: BinaryOp(>, ColumnAccess(left, col), ColumnAccess(right, col))
    auto binOp = cast(BinaryOpInfo) predicate;
    if (binOp is null) return [];

    string op = binOp.operator;
    if (op != "<" && op != ">") return [];

    // Get left and right operands
    auto leftOp = binOp.left;
    auto rightOp = binOp.right;

    // Try to extract column info from each operand
    auto leftColInfo = extractSortColumnInfo(leftOp, leftItem, rightItem);
    auto rightColInfo = extractSortColumnInfo(rightOp, leftItem, rightItem);

    if (leftColInfo.column.length == 0 || rightColInfo.column.length == 0) return [];

    // Both must access the same column
    if (leftColInfo.column != rightColInfo.column) return [];

    // Verify left operand is on left item and right operand is on right item
    if (!leftColInfo.isLeftItem || rightColInfo.isLeftItem) return [];

    // Determine direction: < means ASC, > means DESC
    auto direction = (op == "<") ? SortDirection.ASC : SortDirection.DESC;

    return [OrderBySpec(leftColInfo.column, direction)];
}

/// Info about a column extracted from a sort predicate operand
private struct SortColumnInfo {
    string column;        // SQL column name, empty if not a column access
    bool isLeftItem;      // true if this accesses the left (a) sort item
}

/// Try to extract column info from a sort predicate operand.
private SortColumnInfo extractSortColumnInfo(Object expr, Object leftItem, Object rightItem) {
    import dynamo.core.sorting : SortItemInfo;

    // Check if this is a column access expression
    auto colAccess = cast(ColumnAccessInfo) expr;
    if (colAccess is null) return SortColumnInfo.init;

    // Get the input expression
    auto inputExpr = colAccess.inputExpr();

    // Check if input is one of the sort item placeholders
    if (inputExpr is leftItem) {
        return SortColumnInfo(colAccess.sqlColumn, true);
    } else if (inputExpr is rightItem) {
        return SortColumnInfo(colAccess.sqlColumn, false);
    }

    return SortColumnInfo.init;
}

// ============================================================================
// Filter Pattern Matching
// ============================================================================

/// Extract WHERE clause SQL from a FilterByInfo by pattern-matching its predicate.
///
/// Recognizes patterns like:
/// - (e) => e.column.eq(value) → column = value
/// - (e) => e.column.lt(value) → column < value
/// - (e) => e.col1.eq(x).and(e.col2.lt(y)) → col1 = x AND col2 < y
/// - (e) => e.col1.eq(x).or(e.col2.eq(y)) → col1 = x OR col2 = y
/// - (e) => e.column.eq(x).not() → NOT (column = x)
///
/// Returns null if pattern doesn't match.
private Nullable!string extractFilterWhereClause(FilterByInfo filterInfo) {
    import dynamo.core.expr : BinaryOpInfo, UnaryOpInfo, ConstantInfo;
    import dynamo.core.filtering : FilterItemInfo;

    auto predicate = filterInfo.filterPredicate;
    auto filterItem = filterInfo.filterItem;

    return extractWhereFromExpr(predicate, filterItem);
}

/// Recursively extract WHERE SQL from an expression tree.
private Nullable!string extractWhereFromExpr(Object expr, Object filterItem) {
    import dynamo.core.expr : BinaryOpInfo, UnaryOpInfo, ConstantInfo;

    // Handle binary operators: AND, OR, comparison operators
    if (auto binOp = cast(BinaryOpInfo) expr) {
        string op = binOp.operator;

        // Logical operators: AND, OR
        if (op == "&&" || op == "||") {
            auto leftSql = extractWhereFromExpr(binOp.left, filterItem);
            auto rightSql = extractWhereFromExpr(binOp.right, filterItem);
            if (!leftSql.isNull && !rightSql.isNull) {
                string sqlOp = (op == "&&") ? "AND" : "OR";
                return Nullable!string("(" ~ leftSql.get ~ " " ~ sqlOp ~ " " ~ rightSql.get ~ ")");
            }
            return Nullable!string.init;
        }

        // Comparison operators: ==, !=, <, <=, >, >=
        if (op == "==" || op == "!=" || op == "<" || op == "<=" || op == ">" || op == ">=") {
            // Try to match: column op constant or constant op column
            auto leftColInfo = extractFilterColumnInfo(binOp.left, filterItem);
            auto rightColInfo = extractFilterColumnInfo(binOp.right, filterItem);
            auto leftConst = extractConstant(binOp.left);
            auto rightConst = extractConstant(binOp.right);

            string column, value;
            bool isColumnOnLeft = false;

            if (!leftColInfo.isNull && !rightConst.isNull) {
                column = leftColInfo.get;
                value = rightConst.get;
                isColumnOnLeft = true;
            } else if (!rightColInfo.isNull && !leftConst.isNull) {
                column = rightColInfo.get;
                value = leftConst.get;
                isColumnOnLeft = false;
            } else {
                return Nullable!string.init;
            }

            string sqlOp = translateComparisonOp(op, isColumnOnLeft);
            return Nullable!string(column ~ " " ~ sqlOp ~ " " ~ value);
        }
    }

    // Handle unary NOT operator
    if (auto unaryOp = cast(UnaryOpInfo) expr) {
        if (unaryOp.operator == "!") {
            auto operandSql = extractWhereFromExpr(unaryOp.operand, filterItem);
            if (!operandSql.isNull) {
                return Nullable!string("NOT " ~ operandSql.get);
            }
        }
    }

    // Handle constant true/false
    if (auto constInfo = cast(ConstantInfo) expr) {
        if (constInfo.valueType == typeid(bool)) {
            bool val = constInfo.valueAsString == "true";
            return Nullable!string(val ? "1=1" : "1=0");
        }
    }

    // Handle LIKE expressions (contains, startsWith, endsWith)
    import dynamo.core.expr : LikeInfo;
    if (auto likeInfo = cast(LikeInfo) expr) {
        auto colInfo = extractFilterColumnInfo(likeInfo.likeOperand, filterItem);
        if (!colInfo.isNull) {
            // Escape single quotes in pattern and wrap in quotes
            // The pattern already has % and _ escaped as \% and \_ by escapeLikePattern()
            string escapedPattern = likeInfo.likePattern.replace("'", "''");
            if (likeInfo.caseInsensitive) {
                // Case-insensitive: use LOWER() on both sides (works on all databases)
                return Nullable!string("LOWER(" ~ colInfo.get ~ ") LIKE LOWER('" ~ escapedPattern ~ `') ESCAPE '\'`);
            } else {
                return Nullable!string(colInfo.get ~ " LIKE '" ~ escapedPattern ~ `' ESCAPE '\'`);
            }
        }
    }

    return Nullable!string.init;
}

/// Try to extract column name from an expression that should be a column access on the filter item.
private Nullable!string extractFilterColumnInfo(Object expr, Object filterItem) {
    // Check if this is a column access expression
    auto colAccess = cast(ColumnAccessInfo) expr;
    if (colAccess is null) return Nullable!string.init;

    // Get the input expression and check if it's the filter item placeholder
    auto inputExpr = colAccess.inputExpr();
    if (cast(Object) inputExpr is filterItem) {
        return Nullable!string(colAccess.sqlColumn);
    }

    return Nullable!string.init;
}

/// Extract SQL literal from a constant expression.
private Nullable!string extractConstant(Object expr) {
    import dynamo.core.expr : ConstantInfo;
    import dynamo.relational.sql_optimizer : constantToSqlLiteral;

    auto constInfo = cast(ConstantInfo) expr;
    if (constInfo is null) return Nullable!string.init;

    return Nullable!string(constantToSqlLiteral(constInfo));
}

/// Convert comparison operator to SQL, handling operand order.
private string translateComparisonOp(string op, bool columnOnLeft) {
    if (columnOnLeft) {
        // column op value - use operator as-is
        switch (op) {
            case "==": return "=";
            case "!=": return "<>";
            case "<": return "<";
            case "<=": return "<=";
            case ">": return ">";
            case ">=": return ">=";
            default: return op;
        }
    } else {
        // value op column - reverse operator
        switch (op) {
            case "==": return "=";
            case "!=": return "<>";
            case "<": return ">";    // value < column → column > value
            case "<=": return ">=";
            case ">": return "<";
            case ">=": return "<=";
            default: return op;
        }
    }
}

// ============================================================================
// Base classes for runtime type checking
// ============================================================================

/// Interface for column access expressions (for chain walking and optimizer analysis)
interface ColumnAccessInfo {
    /// The input expression this column is accessed from
    @property ExprBase inputExpr();

    /// The SQL column name (e.g., "first_name")
    @property string sqlColumn();
}

/// Interface for belongsTo expressions (for chain walking)
interface BelongsToInfo {
    @property ExprBase inputExpr();
    @property string childTable();
    @property string parentTable();
    @property string parentTypeName();
    @property string fkColumn();
}

/// Interface for hasMany expressions to expose their metadata.
interface HasManyInfo {
    /// The input expression (points to parent entity)
    @property ExprBase inputExpr();

    /// Foreign key column in child table
    @property string fkColumn();

    /// Child entity type name
    @property string childTypeName();

    /// Child table name
    @property string childTable();

    /// Parent entity type name (for ref encoding)
    @property string parentTypeName();
}

// ============================================================================
// Root Expressions
// ============================================================================

/// Interface for root expressions (GetByIds, GetAll) to expose filter info.
/// Used by optimizer to configure QueryNodes correctly.
interface RootExprInfo {
    /// The filter type (all, byIds)
    FilterType filterType();

    /// For byIds: the refs to filter by
    AnyRef[] filterRefs();

    /// Entity type name for the root query
    string entityTypeName();

    /// Entity table name for the root query
    string entityTable();

    /// The data fetcher for this root (may be null for legacy usage)
    DataFetcher dataFetcher();
}

/// Source ID for an entity - uses table name as unique identifier.
/// This is used to key into RelationalEvalContext for multi-source scenarios.
template entitySourceId(Entity) {
    enum entitySourceId = EntityID!Entity.table;
}

/// Populate plain field values into entities by fetching from database.
/// Used by GetByIdsExpr and GetAllExpr in naive mode to pre-populate fields.
private Promise!(Entity[]) populatePlainFields(Entity)(DataFetcher fetcher, Entity[] entities) {
    import ae.utils.promise : all;
    import dynamo.core.types : AnyRef;

    if (entities.length == 0) {
        return resolve(entities);
    }

    auto refs = entities.map!(e => AnyRef(e.nodeId.id)).array;
    enum table = EntityID!Entity.table;
    enum plainFields = getPlainFieldNames!Entity;

    static if (plainFields.length == 0) {
        // No plain fields to populate
        return resolve(entities);
    } else {
        // Fetch all plain fields in parallel
        Promise!void[] fetches;
        static foreach (fieldName; plainFields) {{
            enum columnName = getPlainFieldColumnName!(Entity, fieldName);
            alias FieldType = typeof(__traits(getMember, Entity.init, fieldName));

            fetches ~= fetcher.fetchColumn!FieldType(table, columnName, refs)
                .then((FieldType[] values) {
                    foreach (i, ref e; entities) {
                        __traits(getMember, e, fieldName) = values[i];
                    }
                });
        }}

        // all(Promise!void[]) returns Promise!void, then we return entities
        return all(fetches).then(() => entities);
    }
}

/// Root expression that returns specific entities by their IDs.
/// Returns typed Entity[] for compile-time type safety.
/// Uses EntityID!Entity.db for data source access.
class GetByIdsExpr(Entity) : Expr!(Entity[]), RootExprInfo {
    import dynamo.core.optimize : ExprOptimizer;

    private Entity[] _entities;

    /// Construct from array of IDs (any type convertible to string)
    this(IdType)(IdType[] ids) {
        _entities = ids.map!(id => Entity(EntityID!Entity.typeName ~ ":" ~ id.to!string)).array;
    }

    this(Entity[] entities) {
        _entities = entities;
    }

    override ExprBase[] dependencies() {
        return [];  // Root node
    }

    override void replaceDependency(size_t index, ExprBase newDep) {
        // No dependencies to replace
    }

    override ExprOptimizer[] requestedOptimizers() {
        // Get fetcher from Entity's data source
        auto fetcher = EntityID!Entity.db;
        if (fetcher !is null) {
            return fetcher.requestedOptimizers();
        }
        return [];
    }

    override Promise!(Entity[][]) eval(EvalContext ctx) {
        // Set up RelationalEvalContext with fetcher from EntityID!Entity.db
        auto fetcher = EntityID!Entity.db;
        if (fetcher !is null) {
            auto relCtx = ctx.getSourceContext!RelationalEvalContext();
            if (relCtx.fetcher is null) {
                relCtx.fetcher = fetcher;
            }
        }

        // Populate eager fields if any exist
        enum plainFields = getPlainFieldNames!Entity;
        static if (plainFields.length > 0) {
            if (fetcher !is null && _entities.length > 0) {
                return populatePlainFields!Entity(fetcher, _entities)
                    .then((Entity[] populated) => [populated]);
            }
        }

        // At root level, there's always exactly 1 parent (queryRoot)
        return resolve([_entities]);
    }

    @property Entity[] entities() { return _entities; }

    // RootExprInfo implementation
    FilterType filterType() { return FilterType.byIds; }
    AnyRef[] filterRefs() { return _entities.map!(e => AnyRef(e.nodeId.id)).array; }
    string entityTypeName() { return EntityID!Entity.typeName; }
    string entityTable() { return EntityID!Entity.table; }
    DataFetcher dataFetcher() { return EntityID!Entity.db; }
}

/// Factory function to create GetByIdsExpr (works with any ID type)
auto getByIds(Entity, IdType)(IdType[] ids) {
    return new GetByIdsExpr!Entity(ids);
}

/// Factory function to create GetByIdsExpr for composite keys.
/// Takes an array of key-part arrays, e.g. [[1, 100], [1, 101]] for orderId, productId.
auto getByCompositeIds(Entity, IdType)(IdType[][] keyParts) {
    import dynamo.core.types : encodeCompositeKey;

    Entity[] entities;
    foreach (parts; keyParts) {
        string[] strParts;
        foreach (p; parts) {
            strParts ~= p.to!string;
        }
        entities ~= Entity(EntityID!Entity.typeName ~ ":" ~ encodeCompositeKey(strParts));
    }
    return new GetByIdsExpr!Entity(entities);
}

/// Root expression that fetches all entities of a type.
/// Returns typed Entity[] for compile-time type safety.
/// Uses EntityID!Entity.db for data source access.
///
/// In the optimized path, a PrefetchExpr is created during optimization
/// and used during eval to ensure data is fetched before reading refs.
class GetAllExpr(Entity) : Expr!(Entity[]), RootExprInfo, MapExprInfo {
    import dynamo.core.optimize : ExprOptimizer, OptimizeContext;

    private {
        PrefetchExpr _prefetch;  // Set during optimization
        int _queryNodeId = -1;   // QueryNode ID for optimized path
    }

    this() {}

    override ExprBase[] dependencies() {
        return _prefetch !is null ? [_prefetch] : [];
    }

    override void replaceDependency(size_t index, ExprBase newDep) {
        if (index == 0 && _prefetch !is null) {
            _prefetch = cast(PrefetchExpr) newDep;
        }
    }

    override ExprOptimizer[] requestedOptimizers() {
        auto fetcher = EntityID!Entity.db;
        if (fetcher !is null) {
            return fetcher.requestedOptimizers();
        }
        return [];
    }

    override Expr!(Entity[]) optimize(OptimizeContext ctx) {
        // Try to find an existing QueryNode created by ColumnAccessExpr optimizations
        // (body is optimized before collection in MapExpr)
        auto fetcher = EntityID!Entity.db;
        if (fetcher is null) return this;

        auto relCtx = ctx.getSourceContext!RelationalOptimizeContext();

        // Look for a root node that matches our entity type and table
        auto node = relCtx.findRootNode(EntityID!Entity.typeName, EntityID!Entity.table);

        if (node is null) {
            // No node found - we're in a context where column access doesn't use optimization
            // (e.g., computed fields that don't access columns)
            // Fall back to naive path
            return this;
        }

        // Use the existing node's prefetch
        _prefetch = relCtx.getPrefetchExpr(node);
        _queryNodeId = node.id;

        return this;
    }

    override Promise!(Entity[][]) eval(EvalContext ctx) {
        auto fetcher = EntityID!Entity.db;

        // Set up RelationalEvalContext with fetcher
        if (fetcher !is null) {
            auto relCtx = ctx.getSourceContext!RelationalEvalContext();
            if (relCtx.fetcher is null) {
                relCtx.fetcher = fetcher;
            }
        }

        // Optimized path: use PrefetchExpr to fetch data, then read refs
        if (_prefetch !is null) {
            return evalAs!(AnyRef[])(_prefetch, ctx).then((AnyRef[][] prefetchResults) {
                // PrefetchExpr returns refs from the QueryResult
                auto refs = prefetchResults.length > 0 ? prefetchResults[0] : [];
                // Convert AnyRef to Entity - refs already have the full nodeId
                auto entities = refs.map!(r => Entity(r.nodeId)).array;
                return [entities];
            });
        }

        // Fallback: naive path using fetchAllIds
        auto relCtx = ctx.getSourceContext!RelationalEvalContext();
        return relCtx.fetchAllIds(EntityID!Entity.table).then((long[] ids) {
            auto entities = ids.map!(id => Entity(EntityID!Entity.typeName ~ ":" ~ id.to!string)).array;

            // Populate eager fields if any exist
            enum plainFields = getPlainFieldNames!Entity;
            static if (plainFields.length > 0) {
                if (fetcher !is null && entities.length > 0) {
                    return populatePlainFields!Entity(fetcher, entities)
                        .then((Entity[] populated) => [populated]);
                }
            }

            // At root level, there's always exactly 1 parent (queryRoot)
            return resolve([entities]);
        });
    }

    // RootExprInfo implementation
    FilterType filterType() { return FilterType.all; }
    AnyRef[] filterRefs() { return []; }
    string entityTypeName() { return EntityID!Entity.typeName; }
    string entityTable() { return EntityID!Entity.table; }
    DataFetcher dataFetcher() { return EntityID!Entity.db; }

    // MapExprInfo implementation (for QueryNode creation)
    Object collection() { return this; }  // We are the root, return self as collection
}

/// Factory function to create GetAllExpr
auto getAll(Entity)() {
    return new GetAllExpr!Entity();
}

// ============================================================================
// Entity Creation and Decoding Utilities
// ============================================================================

/// Create an Entity with its nodeId set from a long ID
Entity makeEntity(Entity)(long id) {
    return Entity(EntityID!Entity.typeName ~ ":" ~ id.to!string);
}

/// Create an Entity with its nodeId set from a string ID
Entity makeEntity(Entity)(string id) {
    return Entity(EntityID!Entity.typeName ~ ":" ~ id);
}

/// Create an Entity with its nodeId set from multiple key values (composite key)
Entity makeCompositeEntity(Entity)(string[] keyValues) {
    import dynamo.core.types : encodeCompositeKey;
    return Entity(EntityID!Entity.typeName ~ ":" ~ encodeCompositeKey(keyValues));
}

/// Convenience overload for two-part composite keys
Entity makeCompositeEntity(Entity, T1, T2)(T1 val1, T2 val2) {
    return makeCompositeEntity!Entity([val1.to!string, val2.to!string]);
}

/// Convenience overload for three-part composite keys
Entity makeCompositeEntity(Entity, T1, T2, T3)(T1 val1, T2 val2, T3 val3) {
    return makeCompositeEntity!Entity([val1.to!string, val2.to!string, val3.to!string]);
}

/// Decode an entity's nodeId to a long (assumes ID portion is numeric)
/// Works with AnyRef (has localId method) and entities (have nodeId.localId)
long decodeAsLong(T)(T entity) {
    static if (__traits(hasMember, T, "localId")) {
        // AnyRef or similar with direct localId method
        return entity.localId.to!long;
    } else static if (__traits(hasMember, T, "nodeId") && __traits(hasMember, typeof(T.init.nodeId), "localId")) {
        // Entity with nodeId struct that has localId
        return entity.nodeId.localId.to!long;
    } else {
        static assert(false, "Type " ~ T.stringof ~ " has no localId accessor");
    }
}

/// Decode multiple entities to long IDs
long[] decodeAsLongs(T)(T[] entities) {
    return entities.map!(e => decodeAsLong(e)).array;
}

/// Decode an entity's localId as composite key parts
/// Works with AnyRef (has localId method) and entities (have nodeId.localId)
string[] decodeEntityCompositeKey(T)(T entity) {
    import dynamo.core.types : decodeCompositeKey;
    static if (__traits(hasMember, T, "localId")) {
        // AnyRef or similar with direct localId method
        return decodeCompositeKey(entity.localId);
    } else static if (__traits(hasMember, T, "nodeId") && __traits(hasMember, typeof(T.init.nodeId), "localId")) {
        // Entity with nodeId struct that has localId
        return decodeCompositeKey(entity.nodeId.localId);
    } else {
        static assert(false, "Type " ~ T.stringof ~ " has no localId accessor");
    }
}

// ============================================================================
// Column Access Expression
// ============================================================================

/// Expression that reads a column from entities.
/// Takes typed Expr!Entity for type safety.
class ColumnAccessExpr(T, Entity) : Expr!T, ColumnAccessInfo {
    private ExprBase _input;  // the entity we're reading from (type-erased for storage)
    string _column;

    this(Expr!Entity input, string column) {
        _input = input;
        _column = column;
    }

    // ColumnAccessInfo implementation
    @property ExprBase inputExpr() { return _input; }
    @property string sqlColumn() { return _column; }

    override ExprBase[] dependencies() {
        return [_input];
    }

    override void replaceDependency(size_t index, ExprBase newDep) {
        if (index == 0)
            _input = newDep;
    }

    override Expr!T optimize(OptimizeContext ctx) {
        // First optimize input
        _input = (cast(Expr!Entity) _input).optimize(ctx);

        // Find the MapExpr this column belongs to
        JoinHop[] joinPath;
        ExprBase baseInput;
        auto mapExpr = findMapExprFromChain(_input, joinPath, baseInput);

        if (mapExpr is null) {
            // Can't optimize, use naive path
            return this;
        }

        // Get the relational optimization context for this data source
        auto relCtx = ctx.getSourceContext!RelationalOptimizeContext();

        // Get or create QueryNode for this MapExpr
        auto node = relCtx.getOrCreateNode(mapExpr, EntityID!Entity.typeName, EntityID!Entity.table);

        // Set the data fetcher on the node (for mutation-returned entities that bypass GetByIdsExpr)
        if (node.dataFetcher is null && EntityID!Entity.db !is null) {
            node.dataFetcher = EntityID!Entity.db;
        }

        // Configure the node based on collection type (if not already configured)
        if (node.rootFilter == FilterType.none && node.parent is null) {
            if (auto mapInfo = cast(MapExprInfo) mapExpr) {
                Object coll = mapInfo.collection;
                Object originalColl = coll;

                // Unwrap pagination and sorting expressions.
                // Standard SQL execution order is: ORDER BY -> OFFSET -> LIMIT
                // Expression nesting: limit(offset(orderBy(source))) is the correct pattern.
                // When unwrapping outside-in, we see: LIMIT, then OFFSET, then ORDER BY.
                // This maps correctly to SQL since we output: ORDER BY ... OFFSET ... LIMIT ...
                //
                // Invalid pattern: orderBy(limit(offset(source))) - would paginate then sort.
                // When unwrapping, we'd see ORDER BY first, then LIMIT/OFFSET.
                // We can't push this down as a single SQL query.
                import dynamo.core.pagination : LimitInfo, OffsetInfo;
                import dynamo.core.sorting : SortByInfo, OrderByInfo;
                import dynamo.core.filtering : FilterByInfo;
                bool seenSort = false;  // Track if we've seen ORDER BY (outside-in)
                while (true) {
                    if (auto limitInfo = cast(LimitInfo) coll) {
                        if (seenSort) {
                            // Pagination inside sorting - can't express in SQL
                            break;
                        }
                        node.setLimit(limitInfo.limitValue);
                        coll = limitInfo.limitSource;
                    } else if (auto offsetInfo = cast(OffsetInfo) coll) {
                        if (seenSort) {
                            // Pagination inside sorting - can't express in SQL
                            break;
                        }
                        node.setOffset(offsetInfo.offsetValue);
                        coll = offsetInfo.offsetSource;
                    } else if (auto orderByInfo = cast(OrderByInfo) coll) {
                        // Column-based OrderBy (already pattern-matched or directly created)
                        foreach (spec; orderByInfo.orderBySpecs) {
                            node.addOrderBy(spec);
                        }
                        coll = orderByInfo.orderBySource;
                        seenSort = true;
                    } else if (auto sortByInfo = cast(SortByInfo) coll) {
                        // Predicate-based SortBy - try to pattern-match for SQL push-down
                        auto specs = extractSortBySpecs(sortByInfo);
                        if (specs.length > 0) {
                            foreach (spec; specs) {
                                node.addOrderBy(spec);
                            }
                            coll = sortByInfo.sortSource;
                            seenSort = true;
                        } else {
                            // Pattern matching failed - can't push down to SQL
                            break;
                        }
                    } else if (auto filterByInfo = cast(FilterByInfo) coll) {
                        // Predicate-based FilterBy - try to pattern-match for SQL push-down
                        auto whereSql = extractFilterWhereClause(filterByInfo);
                        if (!whereSql.isNull) {
                            node.addWhereClause(whereSql.get);
                            coll = filterByInfo.filterSource;
                        } else {
                            // Pattern matching failed - can't push down to SQL
                            // FilterByExpr.eval() will handle it in-memory
                            break;
                        }
                    } else {
                        break;
                    }
                }

                // If pagination was unwrapped, replace the MapExpr's collection
                // to prevent double-application of pagination
                if (coll !is originalColl) {
                    if (auto mapExprBase = cast(ExprBase) mapExpr) {
                        if (auto collExpr = cast(ExprBase) coll) {
                            mapExprBase.replaceDependency(0, collExpr);
                        }
                    }
                }

                // Check if collection is a root expression
                if (auto rootExpr = cast(RootExprInfo) coll) {
                    if (rootExpr.filterType == FilterType.byIds) {
                        node.setRootFilter(FilterType.byIds, rootExpr.filterRefs);
                    } else if (rootExpr.filterType == FilterType.all) {
                        node.setRootFilter(FilterType.all);
                    }
                }
                // Check if collection is a hasMany relationship
                else if (auto hasManyExpr = cast(HasManyInfo) coll) {
                    // Child of a hasMany relationship
                    // Find the parent MapExpr by following parentInput
                    JoinHop[] parentJoinPath;
                    ExprBase parentBaseInput;
                    auto parentMapExpr = findMapExprFromChain(hasManyExpr.inputExpr, parentJoinPath, parentBaseInput);
                    if (parentMapExpr !is null) {
                        auto parentNode = relCtx.getNode(parentMapExpr);
                        if (parentNode !is null) {
                            node.setParent(parentNode, hasManyExpr.fkColumn, hasManyExpr.parentTypeName);

                            // For HasMany with pagination, use per-parent pagination (window functions)
                            // Move global limit/offset to per-parent limit/offset
                            if (!node.limit_.isNull || !node.offset_.isNull) {
                                if (!node.limit_.isNull) {
                                    node.perParentLimit_ = node.limit_;
                                    node.limit_.nullify();
                                }
                                if (!node.offset_.isNull) {
                                    node.perParentOffset_ = node.offset_;
                                    node.offset_.nullify();
                                }
                                node.useWindowFunction = true;
                            }
                        }
                    }
                }
            }
        }

        // If the node wasn't configured with a valid root filter and has no parent,
        // it means the collection isn't a relational expression (e.g., EffectExpr).
        // Fall back to naive path so ColumnAccessExpr.eval() can handle it properly.
        if (node.rootFilter == FilterType.none && node.parent is null) {
            return this;
        }

        // Get the PrefetchExpr for this node
        auto prefetch = relCtx.getPrefetchExpr(node);

        if (joinPath.length == 0) {
            // Direct column access - return projection expression
            node.addColumn(_column);
            return new ProjectColumnExpr!T(node.id, _column, _input, prefetch);
        }

        // Access through belongsTo chain - add JOINs
        // Each hop: source table -> target table via FK
        string lastAlias;
        foreach (hop; joinPath) {
            // Add the FK column to ensure it's fetched (needed for JOIN)
            node.addColumn(hop.fk);
            // Add JOIN and get alias
            lastAlias = node.addJoin(hop.targetTable, hop.targetType, hop.fk);
        }

        // Track the column needed from the final joined table
        node.addJoinedColumn(lastAlias, _column);

        // Return projection that reads from the final joined table
        // Use baseInput (the expression that produces refs for the base table)
        // not _input (which may be a belongsTo that produces refs for a different table)
        return new ProjectJoinedColumnExpr!T(node.id, lastAlias, _column, baseInput, prefetch);
    }

    override Promise!(T[]) eval(EvalContext ctx) {
        auto column = _column;
        auto input = _input;

        // Ensure fetcher is set up from Entity's data source
        auto relCtx = ctx.getSourceContext!RelationalEvalContext();
        if (relCtx.fetcher is null && EntityID!Entity.db !is null) {
            relCtx.fetcher = EntityID!Entity.db;
        }

        // Get the entity refs from the input chain, then fetch column
        return evalRefAsAnyRef(input, ctx).then((AnyRef[] entityRefs) {
            debug(filter) {
                import std.stdio : writefln;
                import std.algorithm : map;
                import std.array : array;
                writefln("    ColumnAccessExpr.eval: table=%s, column=%s, refs=%s",
                    EntityID!Entity.table, column, entityRefs.map!(r => r.nodeId).array);
            }

            // First, check for mutation results (mutations store their results here)
            if (relCtx.hasMutationResult(EntityID!Entity.typeName)) {
                return resolve(relCtx.getMutationColumnValues!T(EntityID!Entity.typeName, column, entityRefs));
            }

            // Otherwise, fetch from database (async)
            if (relCtx.fetcher !is null) {
                return relCtx.fetcher.fetchColumn!T(EntityID!Entity.table, column, entityRefs);
            }

            // Fallback to empty results
            return resolve(entityRefs.map!(_ => T.init).array);
        });
    }

    @property string column() { return _column; }
    @property ExprBase input() { return _input; }
}

// ============================================================================
// HasMany Access Expression
// ============================================================================

/// Expression representing a one-to-many relationship.
/// Takes typed Parent input, returns typed Child[] for each parent.
class HasManyAccessExpr(Parent, Child, string fk) : Expr!(Child[]), HasManyInfo {
    private ExprBase _input;

    static if (!is(Parent == void)) {
        this(Expr!Parent input) {
            _input = input;
        }
    } else {
        this(ExprBase input) {
            _input = input;
        }
    }

    override ExprBase[] dependencies() {
        return [_input];
    }

    override void replaceDependency(size_t index, ExprBase newDep) {
        if (index == 0)
            _input = newDep;
    }

    static if (!is(Parent == void)) {
        override Expr!(Child[]) optimize(OptimizeContext ctx) {
            _input = (cast(Expr!Parent) _input).optimize(ctx);
            // HasMany doesn't transform itself - the inner MapExpr's
            // access expressions will create a child QueryNode
            return this;
        }
    } else {
        override Expr!(Child[]) optimize(OptimizeContext ctx) {
            // Can't optimize input without Parent type
            return this;
        }
    }

    override Promise!(Child[][]) eval(EvalContext ctx) {
        auto input = _input;

        // Ensure fetcher is set up from Child entity's data source
        auto relCtx = ctx.getSourceContext!RelationalEvalContext();
        if (relCtx.fetcher is null && EntityID!Child.db !is null) {
            relCtx.fetcher = EntityID!Child.db;
        }

        // Get the parent refs from the input chain, then fetch children
        return evalRefAsAnyRef(input, ctx).then((AnyRef[] parentRefs) {
            debug(filter) {
                import std.stdio : writefln, stdout;
                import std.algorithm : map;
                import std.array : array;
                writefln("    HasManyAccessExpr.eval: parentRefs=%s, fk=%s, childTable=%s",
                    parentRefs.map!(r => r.nodeId).array, fk, EntityID!Child.table);
                stdout.flush();
            }
            // Naive path: fetch children directly (async)
            if (relCtx.fetcher !is null) {
                return relCtx.fetcher.fetchChildren(EntityID!Child.table, EntityID!Child.typeName, fk, parentRefs)
                    .then((AnyRef[][] children) {
                        debug(filter) {
                            import std.stdio : writefln, stdout;
                            import std.algorithm : map;
                            import std.array : array;
                            writefln("    HasManyAccessExpr.eval: fetched children=%s",
                                children.map!(g => g.map!(r => r.nodeId).array).array);
                            stdout.flush();
                        }
                        // Convert AnyRef[][] to Child[][]
                        return children.map!(group => group.map!(r => Child(r.nodeId)).array).array;
                    });
            }

            // Fallback to empty results
            return resolve(parentRefs.map!(_ => cast(Child[])[]).array);
        });
    }

    @property ExprBase input() { return _input; }

    // HasManyInfo implementation
    @property ExprBase inputExpr() { return _input; }
    @property string childTable() { return EntityID!Child.table; }
    @property string childTypeName() { return EntityID!Child.typeName; }
    @property string fkColumn() { return fk; }
    static if (!is(Parent == void)) {
        @property string parentTypeName() { return EntityID!Parent.typeName; }
    } else {
        @property string parentTypeName() { return ""; }
    }
}

// ============================================================================
// BelongsTo Access Expression
// ============================================================================

/// Expression representing a many-to-one relationship.
/// Takes typed Child input, returns typed Parent for each child.
/// ResultType is either Parent (required FK) or Nullable!Parent (optional FK).
/// Implements AnyRefEvaluable for type-agnostic evaluation by downstream expressions.
class BelongsToAccessExpr(Child, Parent, ResultType, string fk) : Expr!ResultType, BelongsToInfo, AnyRefEvaluable {
    private ExprBase _input;

    static if (!is(Child == void)) {
        this(Expr!Child input) {
            _input = input;
        }
    } else {
        this(ExprBase input) {
            _input = input;
        }
    }

    override ExprBase[] dependencies() {
        return [_input];
    }

    override void replaceDependency(size_t index, ExprBase newDep) {
        if (index == 0)
            _input = newDep;
    }

    static if (!is(Child == void)) {
        override Expr!ResultType optimize(OptimizeContext ctx) {
            import std.typecons : Nullable;

            _input = (cast(Expr!Child) _input).optimize(ctx);

            // Only optimize nullable BelongsTo to use projection.
            // Non-nullable BelongsTo is never evaluated directly - only its
            // columns are accessed via JOINs, so we need to keep the chain
            // traversable for ColumnAccessExpr.optimize().
            static if (!is(ResultType == Nullable!Parent)) {
                return this;
            } else {
                // Find the MapExpr this belongsTo belongs to
                JoinHop[] joinPath;
                ExprBase baseInput;
                auto mapExpr = findMapExprFromChain(_input, joinPath, baseInput);

                if (mapExpr is null) {
                    // Can't optimize, use naive path (fetchBelongsTo)
                    return this;
                }

                // Get the relational optimization context
                auto relCtx = ctx.getSourceContext!RelationalOptimizeContext();
                if (relCtx is null) {
                    return this;
                }

                // Get the QueryNode for this MapExpr
                auto node = relCtx.getNode(mapExpr);
                if (node is null) {
                    // Node not created yet - let ColumnAccessExpr create it
                    return this;
                }

                // Add the FK column to the query
                node.addColumn(fk);

                // Get the PrefetchExpr for this node
                auto prefetch = relCtx.getPrefetchExpr(node);

                // Create projection that reads FK from query results
                import dynamo.relational.project : ProjectBelongsToExpr, ProjectTypedBelongsToExpr;
                auto innerProj = new ProjectBelongsToExpr(node.id, fk, EntityID!Parent.typeName, baseInput, prefetch);
                return new ProjectTypedBelongsToExpr!(Child, Parent, ResultType, fk)(innerProj, baseInput);
            }
        }
    } else {
        override Expr!ResultType optimize(OptimizeContext ctx) {
            return this;
        }
    }

    /// Evaluate and return as AnyRef[] (for type-agnostic internal use).
    /// Converts typed Parent to AnyRef, handling Nullable properly.
    Promise!(AnyRef[]) evalAsAnyRef(EvalContext ctx) {
        return this.eval(ctx).then((ResultType[] results) {
            static if (is(ResultType == Parent)) {
                // Direct conversion from entity to AnyRef via nodeId
                return results.map!(r => AnyRef(r.nodeId.id)).array;
            } else static if (is(ResultType == Nullable!Parent)) {
                // Handle nullable - convert valid refs, use AnyRef.init for null
                return results.map!(r => r.isNull ? AnyRef.init : AnyRef(r.get.nodeId.id)).array;
            } else {
                static assert(false, "Unexpected ResultType in BelongsToAccessExpr");
            }
        });
    }

    override Promise!(ResultType[]) eval(EvalContext ctx) {
        auto input = _input;

        // Ensure fetcher is set up from Child entity's data source
        static if (!is(Child == void)) {
            auto relCtx = ctx.getSourceContext!RelationalEvalContext();
            if (relCtx.fetcher is null && EntityID!Child.db !is null) {
                relCtx.fetcher = EntityID!Child.db;
            }
        }

        // Get the child refs from the input chain, then fetch parent
        return evalRefAsAnyRef(input, ctx).then((AnyRef[] childRefs) {
            static if (is(Child == void)) {
                // Can't fetch without knowing child entity type
                return resolve(childRefs.map!(_ => ResultType.init).array);
            } else {
                // Naive path: fetch parent refs directly (async)
                auto relCtx = ctx.getSourceContext!RelationalEvalContext();
                if (relCtx.fetcher !is null) {
                    return relCtx.fetcher.fetchBelongsTo(EntityID!Child.table, fk, EntityID!Parent.typeName, childRefs)
                        .then((AnyRef[] parentRefs) {
                            static if (is(ResultType == Parent)) {
                                // Convert AnyRef[] to Parent[] via nodeId
                                return parentRefs.map!(r => Parent(r.nodeId)).array;
                            } else static if (is(ResultType == Nullable!Parent)) {
                                // Wrap in Nullable, handling invalid refs as null
                                return parentRefs.map!(r => r.isValid ? Nullable!Parent(Parent(r.nodeId)) : Nullable!Parent.init).array;
                            } else {
                                static assert(false, "ResultType must be Parent or Nullable!Parent");
                            }
                        });
                }

                return resolve(childRefs.map!(_ => ResultType.init).array);
            }
        });
    }

    @property ExprBase input() { return _input; }

    // For base class interface (runtime type checking)
    @property ExprBase inputExpr() { return _input; }
    static if (!is(Child == void)) {
        @property string childTable() { return EntityID!Child.table; }
    } else {
        @property string childTable() { return ""; }
    }
    @property string parentTable() { return EntityID!Parent.table; }
    @property string parentTypeName() { return EntityID!Parent.typeName; }
    @property string fkColumn() { return fk; }
}

